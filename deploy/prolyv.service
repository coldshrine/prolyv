# systemd unit for Prolyv. Install:
#   sudo cp deploy/prolyv.service /etc/systemd/system/prolyv.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now prolyv
# Logs: journalctl -u prolyv -f

[Unit]
Description=Prolyv — tea diary, forum and blog (uvicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/prolyv
# Secrets live here (chmod 640, owned by root:ubuntu).
EnvironmentFile=/etc/prolyv.env
Environment=PYTHONDONTWRITEBYTECODE=1
# Only a Unix socket, shared with the Caddy container through a bind mount: no TCP port to open or firewall. Only Caddy
# reaches the socket, which is why trusting X-Forwarded-* from it is acceptable.
ExecStart=/home/ubuntu/prolyv/.venv/bin/uvicorn prolyv.main:app \
    --uds /var/lib/prolyv/run/prolyv.sock \
    --proxy-headers --forwarded-allow-ips=* \
    --workers 1 --timeout-keep-alive 10
Restart=always
RestartSec=3
# The micro VM has 956 MB RAM; keep one worker and let systemd restart on trouble.
MemoryMax=300M

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/prolyv
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
UMask=0027

[Install]
WantedBy=multi-user.target
