# Caddy site for Prolyv with automatic HTTPS (Let's Encrypt).
#
# On the shared Oracle VM, Caddy runs as a Docker container for the Dota analyzer and owns ports 80/443. Do NOT start a
# second Caddy there. Append the site block below to that container's Caddyfile
# (~/dota-tournament-analyzer/deploy/Caddyfile), and give the caddy service in docker-compose.yml this extra volume:
#   - /var/lib/prolyv/run:/run/prolyv
# Then `sudo docker compose up -d --no-deps caddy`. See README -> "Deploy to the Oracle VM".
#
# That Caddyfile must start with this global block. QUIC/UDP 443 is blocked by the OCI firewall, and without it browsers
# hang on HTTP/3:
#
# {
# 	servers {
# 		protocols h1 h2
# 	}
# }

# Replace with your real domain once you have one; sslip.io needs no DNS setup.
prolyv.144.24.168.1.sslip.io {
	encode zstd gzip

	request_body {
		max_size 60MB
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy unix//run/prolyv/prolyv.sock
}
