# Caddy site for Prolyv with automatic HTTPS (Let's Encrypt).
#
# Standalone Caddy on the host (apt install caddy): copy to /etc/caddy/Caddyfile and `sudo systemctl reload caddy`.
#
# On the shared Oracle VM, Caddy already runs as a Docker container for the Dota analyzer and owns ports
# 80/443. Do NOT start a second Caddy there: paste the site block below into that container's Caddyfile
# (~/dota-tournament-analyzer/deploy/Caddyfile), change the upstream to host.docker.internal:8010, add
#   extra_hosts: ["host.docker.internal:host-gateway"]
# to the caddy service in docker-compose.yml, set BIND_HOST=0.0.0.0 in /etc/prolyv.env, and run
# `sudo docker compose up -d` in that deploy folder. See README → "Deploy to the Oracle VM".

{
	# QUIC/UDP 443 is blocked by the OCI firewall; TCP h1/h2 only, same as the Dota analyzer.
	servers {
		protocols h1 h2
	}
}

# Replace with your real domain once you have one; sslip.io needs no DNS setup.
prolyv.144.24.168.1.sslip.io {
	encode zstd gzip

	request_body {
		max_size 60MB
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Standalone Caddy on the host:
	reverse_proxy 127.0.0.1:8010
	# Caddy inside Docker (Dota analyzer compose):
	# reverse_proxy host.docker.internal:8010

	log {
		output file /var/log/caddy/prolyv.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
