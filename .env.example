# Copy to .env (local) or /etc/prolyv.env (server). Never commit the filled-in copy.

# 48+ random characters. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# Public origin of the site, no trailing slash. Cookies are marked Secure when this is https.
BASE_URL=http://localhost:8000

# SQLite (WAL) locally; on the server: sqlite:////var/lib/prolyv/prolyv.db
# Postgres later: postgresql+psycopg://user:pass@host/prolyv
DATABASE_URL=sqlite:///./prolyv.db

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application)
# Authorized redirect URI must be exactly: <BASE_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# @BotFather: /newbot, then /setdomain -> the host part of BASE_URL (e.g. prolyv.example.com)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Where uvicorn listens (used by deploy/prolyv.service). Keep 127.0.0.1 when Caddy runs on the host;
# use 0.0.0.0 when Caddy runs in Docker and reaches the host via host.docker.internal.
BIND_HOST=127.0.0.1
BIND_PORT=8010

# E-mail sign-in links. Any SMTP relay works (Gmail app password, Brevo, Postmark, Mailgun...).
# Without SMTP: on localhost the link is shown on the page; in production the e-mail option is hidden.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=1

# Footer links; leave empty to hide
SOCIAL_TIKTOK=
SOCIAL_INSTAGRAM=

# Handles (comma-separated) allowed to administer the site: tea cards, blog posts, moderation
ADMIN_HANDLES=

# Local development only: "Continue as demo user" on /login and GET /dev/login/<handle>.
# The app refuses to start with DEV_LOGIN=1 unless BASE_URL is localhost. Users: uv run python scripts/seed_demo.py
DEV_LOGIN=0

# Tea and session photos; on the server: /var/lib/prolyv/media
MEDIA_DIR=media

# Optional tuning
SESSION_DAYS=30
AUTH_RATE_LIMIT=30
AUTH_RATE_WINDOW=60
